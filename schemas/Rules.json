{
  "$ref": "#/$defs/RulesFile",
  "$defs": {
    "RulesFile": {
      "title": "RulesFile",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "Rules"
          ]
        },
        "rules": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/SimpleRule"
              },
              {
                "$ref": "#/$defs/StringMapRule"
              },
              {
                "$ref": "#/$defs/RuleSequence"
              }
            ],
            "discriminator": {
              "propertyName": "kind",
              "mapping": {
                "simple": "#/$defs/SimpleRule",
                "string_map": "#/$defs/StringMapRule",
                "rule_sequence": "#/$defs/RuleSequence"
              }
            }
          }
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "rules"
      ]
    },
    "SimpleRule": {
      "title": "SimpleRule",
      "description": "A context-sensitive rewrite rule.",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "simple"
          ]
        },
        "name": {
          "type": "string"
        },
        "input_pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "output_pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "left_context": {
          "type": "string",
          "default": ""
        },
        "right_context": {
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "kind",
        "name",
        "input_pattern",
        "output_pattern"
      ]
    },
    "StringMapRule": {
      "title": "StringMapRule",
      "description": "A rule for mapping strings.",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "string_map"
          ]
        },
        "name": {
          "type": "string"
        },
        "string_map": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "items": false
          }
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "left_context": {
          "type": "string",
          "default": ""
        },
        "right_context": {
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "kind",
        "name",
        "string_map"
      ]
    },
    "RuleSequence": {
      "title": "RuleSequence",
      "description": "A sequence of rules to be applied.\nHere just stored as a list of strings indicating rule names,\nwhich are resolved to rule data up in `fst_compilation.compile_rule`",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "rule_sequence"
          ]
        },
        "name": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "kind",
        "name",
        "rules"
      ]
    }
  }
}
