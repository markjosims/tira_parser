{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ContingentFeatureMarkers",
  "description": "Schema for morphological realizations contingent on multiple features.",
  "type": "object",
  "required": [
    "kind",
    "features",
    "markers"
  ],
  "additionalProperties": false,
  "properties": {
    "source_path": {
      "type": "string",
      "description": "The file path from which this config was loaded."
    },
    "kind": {
      "type": "string",
      "enum": [
        "ContingentFeatureMarkers"
      ]
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of features in the order they are nested in the markers object."
    },
    "global_stage": {
      "type": "string",
      "description": "Allows specifying a default value for the 'stage' attribute."
    },
    "global_markers": {
      "type": "array",
      "items": {
        "$ref": "./FeatureMarkers.json#/definitions/marker"
      },
      "description": "A marker or list of markers applied to all forms in this paradigm."
    },
    "markers": {
      "$ref": "#/definitions/nested_markers"
    }
  },
  "definitions": {
    "nested_markers": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "./FeatureMarkers.json#/definitions/marker"
          }
        },
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/nested_markers"
          }
        }
      ]
    }
  }
}